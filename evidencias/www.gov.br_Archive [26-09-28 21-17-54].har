          "content": {
            "mimeType": "application/javascript",
            "size": 194,
            "text": "export function cookiesByName() {\n    const result = {};\n    document.cookie\n        .split(';')\n        .map(c => {\n            const parts = c.split('=', 2);\n            if (parts.length != 2) {\n                return;\n            }\n            result[parts[0].trim()] = parts[1].trim();\n        });\n    return result;\n}\n"
          },
