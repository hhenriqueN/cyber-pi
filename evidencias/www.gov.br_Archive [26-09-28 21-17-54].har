            "mimeType": "application/javascript",
            "size": 6679,
            "text": "import { E as Env, r as registerInstance, c as createEvent, g as getElement, h } from './index-DsKFTV2F.js';\nimport { S as SpeechToTextController } from './speech-to-text-UhCLnfPv.js';\n\nfunction getApiBaseUrl() {\n    return Env.API_BASE_URL;\n}\n\n/**\n * Cliente HTTP padrão usando fetch nativo.\n * Usado quando o consumidor não fornece um httpClient customizado.\n */\nconst defaultHttpClient = {\n    async post(url, body, headers) {\n        const response = await fetch(url, {\n            method: 'POST',\n            headers: {\n                'Content-Type': 'application/json',\n                ...headers,\n            },\n            body: JSON.stringify(body),\n        });\n        if (!response.ok) {\n            const errorBody = await response.json().catch(() => ({}));\n            const erro = {\n                statusCode: response.status,\n                mensagem: errorBody?.mensagem || errorBody?.message || `Erro HTTP ${response.status}`,\n                codigo: mapHttpStatusToCode(response.status),\n                timestamp: new Date().toISOString(),\n            };\n            throw erro;\n        }\n        return response.json();\n    },\n};\n/**\n * Envia a avaliação para o backend com os headers de autenticação.\n *\n * @param url - URL do endpoint de avaliação\n * @param payload - Dados da avaliação\n * @param config - Configuração com token e clientId\n * @param httpClient - Cliente HTTP customizado (opcional). Se não fornecido, usa fetch nativo.\n * @throws {EscutaErroDetail} quando a resposta HTTP não é ok.\n */\nasync function enviarAvaliacao(url, payload, config, httpClient) {\n    const client = httpClient ?? defaultHttpClient;\n    const headers = {\n        'Authorization': `Bearer ${config.token}`,\n        'X-Client-Id': config.clientId,\n    };\n    const dados = await client.post(url, payload, headers);\n    return {\n        statusCode: 200,\n        mensagem: 'Avaliação enviada com sucesso.',\n        dados,\n        timestamp: new Date().toISOString(),\n    };\n}\nfunction mapHttpStatusToCode(status) {\n    if (status === 401 || status === 403)\n        return 'ERRO_AUTENTICACAO';\n    if (status >= 500)\n        return 'ERRO_SERVIDOR';\n    return 'ERRO_INESPERADO';\n}\n\nconst formularioEscutaGovCss = () => `@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-300.woff2') format('woff2');font-weight:300;font-style:normal;font-display:swap}@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-400.woff2') format('woff2');font-weight:400;font-style:normal;font-display:swap}@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-400i.woff2') format('woff2');font-weight:400;font-style:italic;font-display:swap}@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-500.woff2') format('woff2');font-weight:500;font-style:normal;font-display:swap}@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-600.woff2') format('woff2');font-weight:600;font-style:normal;font-display:swap}@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-700.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap}@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-700i.woff2') format('woff2');font-weight:700;font-style:italic;font-display:swap}@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-800.woff2') format('woff2');font-weight:800;font-style:normal;font-display:swap}@font-face{font-family:'Rawline';src:url('../../assets/font/rawline-900.woff2') format('woff2');font-weight:900;font-style:normal;font-display:swap}formulario-escuta-gov{display:block;width:100%;max-width:600px}.escuta-container{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;font-family:'Rawline', sans-serif}.escuta-container--mobile{min-width:0}.conteudo-formulario{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;padding:0 1rem}.fade-wrapper{width:100%;animation:fadeIn 0.4s ease}@keyframes fadeIn{from{opacity:0}to{opacity:1}}.modal-header-area{display:flex;flex-direction:column;justify-content:center;align-items:center;margin-bottom:1rem;max-width:450px;width:100%;gap:20px}.icone-comentario{font-size:30px !important;color:#0c326f}.modal-title{display:flex;align-items:center;justify-content:center;text-align:center;white-space:nowrap}.texto-titulo{display:flex;font-size:29.3px;font-weight:600;color:var(--blue-warm-vivid-80);font-family:'Rawline', sans-serif}.modal-subtitle{display:flex;align-items:center;justify-content:center;padding:0 1rem}.texto-subtitulo{font-size:14px;font-weight:400;font-family:'Rawline', sans-serif;color:#333333}@media (max-width: 500px){.texto-titulo{font-size:20px}.modal-title .icone-comentario{font-size:20px !important}}.modal-thumbs{display:flex;flex-direction:column;align-items:center;justify-content:center;margin-bottom:1rem;margin-top:1.5rem}.modal-content-area{display:flex;flex-direction:column;align-items:center;justify-content:center}.texto-pergunta{font-size:16.8px;font-weight:500;color:var(--gray-80);-webkit-text-stroke-width:0.4px;transition:font-size 0.3s ease, -webkit-text-stroke-width 0.3s ease}.texto-pergunta--ativo{font-size:14px;-webkit-text-stroke-width:0}.botao-thumb{background-color:transparent !important}.botao-thumb--selecionado{background-color:#0C326F !important}.botao-thumb--selecionado:hover{background-color:#0C326F !important}.icone-thumb{font-size:20px !important;color:#1351B4}.icone-thumb--selecionado{font-size:19px !important;color:#fff !important}.thumb-text{font-size:14px;color:var(--gray-80);font-weight:600}.thumb-text--selecionado{font-size:14px;color:var(--gray-80);font-weight:700}.thumbs-gap{display:flex;gap:30px;margin-top:16px}.modal-tags{display:flex;flex-direction:column;gap:5px;margin-top:2rem;padding:0 1rem}.texto-strong{font-size:16.8px;font-weight:700;color:var(--gray-80);font-family:'Rawline', sans-serif}.texto-opcional{font-weight:400;font-size:14px;color:var(--gray-80);font-family:'Rawline', sans-serif}.textarea-wrapper{position:relative;display:flex;flex-direction:column;border:1px solid var(--gray-80);border-radius:4px;background:#fff}.textarea-wrapper:focus-within{outline:4px solid var(--focus);outline-offset:-4px;border-radius:4px}.textarea-estilizado{width:100%;resize:none;overflow-y:auto;border:none !important;border-radius:4px 4px 0 0 !important;outline:none}.textarea-estilizado:focus{outline:none !important;box-shadow:none !important;border:none !important}.botao-microfone-pos{display:flex;align-items:center;padding:3px;border-radius:0 0 4px 4px;background:#fff}.texto-ouvindo{font-size:14px;color:#888;line-height:32px;margin-left:8px}.botao-microfone-pos:hover .texto-ouvindo{display:none}.texto-contador{font-size:14px}.br-step-wrapper{display:flex;justify-content:center;pointer-events:none;cursor:default;user-select:none}.br-step-wrapper *{pointer-events:none !important;cursor:default !important;outline:none !important}.br-step-wrapper .br-step{width:80px}.br-step-wrapper .br-step .step-progress .step-progress-btn.active::after{height:4px;background-color:#d3d3d3}.br-step-wrapper .br-step .step-progress .step-progress-btn.active:has(+.step-progress-btn.active)::after,.br-step-wrapper .br-step .step-progress .step-progress-btn.active+.step-progress-btn.active::after{height:4px;background-color:var(--blue-warm-vivid-40)}.br-step-wrapper .br-step .step-progress .step-progress-btn.active::before{background-color:var(--blue-warm-vivid-40);border:none}.br-step-wrapper .br-step .step-progress .step-progress-btn::before{background-color:#d3d3d3;border:none}.br-step-wrapper .br-step .step-progress .step-progress-btn::after{height:4px;background-color:#d3d3d3;border:none}.step-check-icon{color:#fff;position:absolute;top:50%;left:50%;transform:translate(-50%, -50%) !important;z-index:2;font-size:8px !important;line-height:1;pointer-events:none}.full-width-column{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%}.mensagem-sucesso-centralizada{width:100%}.mensagem-sucesso-centralizada .br-message{justify-content:center;align-items:center}.mensagem-sucesso-centralizada .br-message .content{flex:unset}.mensagem-sucesso-centralizada .br-message .icon{margin-right:5px;padding-right:0}.text-strong-blue{font-size:16px;font-weight:700;color:var(--blue-warm-vivid-80)}.botoes-acao{display:flex;justify-content:space-between;gap:16px;padding:10px 0}.collapse-header{display:flex;align-items:center;justify-content:space-between;width:100%;background:transparent;border:none;cursor:pointer;padding:12px 0;font-size:14px}.collapse-header-content{display:flex;align-items:center;gap:12px;font-size:14px;font-weight:600;color:var(--blue-warm-vivid-80)}.collapse-icon{transition:transform 0.3s ease;transform:rotate(0deg);font-size:16px;color:var(--blue-warm-vivid-70, #1351B4)}.collapse-icon--expandido{transform:rotate(180deg)}.collapse-body{overflow:hidden;max-height:0}.collapse-body--expandido{max-height:2000px}.collapse-body--animado{transition:max-height 0.4s ease}.collapse-body .texto-pergunta,.collapse-body .texto-pergunta--ativo{font-size:16px;white-space:normal;word-break:break-word;text-align:center}.collapse-body .modal-thumbs,.collapse-body .modal-content-area{width:100%;min-width:0}.collapse-body .escuta-container{min-width:0}.collapse-body .text-strong-blue{text-align:center}`;\n\nconst FormularioEscutaGov = class {\n    constructor(hostRef) {\n        registerInstance(this, hostRef);\n        this.escutaSucesso = createEvent(this, \"escutaSucesso\", 6);\n        this.escutaErro = createEvent(this, \"escutaErro\", 6);\n    }\n    get el() { return getElement(this); }\n    apiUrl = '/api/escuta-gov-br/avaliacao';\n    /**\n     * Provider de autenticação que fornece token e CPF sob demanda.\n     * Deve ser passado via JavaScript (propriedade), nunca como atributo HTML.\n     *\n     * @example\n     * ```js\n     * const escuta = document.querySelector('formulario-escuta-gov');\n     * escuta.authProvider = {\n     *   getToken: () => sessionStorage.getItem('token'),\n     *   getCpf: () => sessionStorage.getItem('cpf'),\n     * };\n     * ```\n     */\n    authProvider;\n    /**\n     * Identificador do sistema consumidor.\n     * No HTML, usar o atributo `client-id`.\n     */\n    clientId;\n    /**\n     * Identificador ou rota da página onde o componente está renderizado.\n     */\n    page;\n    /**\n     * Cliente HTTP customizado para realizar as requisições.\n     * Permite que o consumidor configure proxy, interceptors, logging, etc.\n     * Se não fornecido, usa fetch nativo do browser.\n     *\n     * @example\n     * ```js\n     * // Passando requisições por um BFF/proxy\n     * const escuta = document.querySelector('formulario-escuta-gov');\n     * escuta.httpClient = {\n     *   post: async (url, body, headers) => {\n     *     const response = await fetch('/api/proxy', {\n     *       method: 'POST',\n     *       headers: { ...headers, 'X-Target-Url': url },\n     *       body: JSON.stringify(body),\n     *     });\n     *     if (!response.ok) throw await response.json();\n     *     return response.json();\n     *   }\n     * };\n     * ```\n     */\n    httpClient;\n    /**\n     * Emitido quando a avaliação é enviada com sucesso.\n     */\n    escutaSucesso;\n    /**\n     * Emitido quando ocorre qualquer erro (validação, rede, servidor).\n     */\n    escutaErro;\n    feedback = null;\n    etapa = 1;\n    finalizado = false;\n    tagsSelecionadas = [];\n    motivoOutros = '';\n    erroEnvio = null;\n    comentario = '';\n    collapseAberto = false;\n    collapseAnimado = false;\n    micComentarioAtivo = false;\n    erroMicComentario = null;\n    micStatusMessage = null;\n    /**\n     * Indica se o componente deve usar o layout mobile (collapse).\n     * No HTML, usar o atributo `is-mobile`.\n     */\n    isMobile = false;\n    /**\n     * Indica se o collapse deve iniciar aberto (apenas no modo mobile).\n     * No HTML, usar o atributo `init-open`.\n     */\n    initOpen = false;\n    speechController;\n    micSuportado = false;\n    finalizadoTimeout;\n    deveFazerScroll = false;\n    componentWillLoad() {\n        if (this.isMobile && this.initOpen) {\n            this.collapseAberto = true;\n            this.collapseAnimado = true;\n        }\n        this.speechController = new SpeechToTextController((texto) => {\n            this.comentario = this.comentario ? `${this.comentario} ${texto}` : texto;\n        }, () => {\n            this.micComentarioAtivo = this.speechController.listening;\n            this.erroMicComentario = this.speechController.error;\n            this.micStatusMessage = this.speechController.statusMessage;\n        });\n        this.micSuportado = this.speechController.supported;\n    }\n    disconnectedCallback() {\n        this.speechController?.stop();\n        if (this.finalizadoTimeout)\n            clearTimeout(this.finalizadoTimeout);\n    }\n    onFinalizadoChange(novo) {\n        if (novo) {\n            this.finalizadoTimeout = setTimeout(() => this.resetarEstado(), 5000);\n        }\n    }\n    onFeedbackChange() {\n        this.tagsSelecionadas = [];\n        this.motivoOutros = '';\n        if (this.feedback) {\n            this.deveFazerScroll = true;\n        }\n    }\n    componentDidRender() {\n        if (this.deveFazerScroll) {\n            this.deveFazerScroll = false;\n            const target = this.el.querySelector('.botoes-acao');\n            if (target) {\n                target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n            }\n        }\n    }\n    resetarEstado() {\n        this.feedback = null;\n        this.etapa = 1;\n        this.comentario = '';\n        this.finalizado = false;\n        this.tagsSelecionadas = [];\n        this.motivoOutros = '';\n        this.erroEnvio = null;\n    }\n    get perguntaSeguinte() {\n        if (this.etapa === 2)\n            return 'Você encontrou algum problema ou tem alguma sugestão de melhoria?';\n        return this.feedback === 'positivo'\n            ? 'O que você mais gostou na página?'\n            : 'O que mais afetou sua experiência?';\n    }\n    montarResultado() {\n        const resultado = {\n            avaliacao: this.feedback === 'positivo' ? 'positivo' : 'negativo',\n            tags: [...this.tagsSelecionadas],\n        };\n        if (this.motivoOutros?.trim())\n            resultado.descricao_tag_outros = this.motivoOutros.trim();\n        if (this.comentario?.trim())\n            resultado.feedback = this.comentario.trim();\n        return resultado;\n    }\n    handleSelecaoTagsChange = (e) => {\n        this.tagsSelecionadas = e.detail.ids;\n        this.motivoOutros = e.detail.textoOutros ?? '';\n    };\n    /**\n     * Resolve o token JWT a partir do authProvider.\n     */\n    async resolverToken() {\n        if (this.authProvider) {\n            return await this.authProvider.getToken();\n        }\n        return undefined;\n    }\n    /**\n     * Resolve o CPF do usuário a partir do authProvider.\n     */\n    async resolverCpf() {\n        if (this.authProvider) {\n            return await this.authProvider.getCpf();\n        }\n        return undefined;\n    }\n    async enviarAvaliacao() {\n        let tokenResolvido;\n        let cpfResolvido;\n        try {\n            [tokenResolvido, cpfResolvido] = await Promise.all([\n                this.resolverToken(),\n                this.resolverCpf(),\n            ]);\n        }\n        catch {\n            const erroProvider = this.criarErro('Falha ao obter credenciais do authProvider.', 'ERRO_AUTENTICACAO');\n            this.escutaErro.emit(erroProvider);\n            this.erroEnvio = erroProvider.mensagem;\n            return;\n        }\n        const erroValidacao = this.validarPreEnvio(tokenResolvido, cpfResolvido);\n        if (erroValidacao) {\n            this.