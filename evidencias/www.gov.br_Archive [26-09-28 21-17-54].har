          "content": {
            "mimeType": "application/javascript",
            "size": 2672,
            "text": "const MENSAGENS_ERRO = {\n    'not-allowed': 'Permissão de microfone negada. Permita o acesso ao microfone nas configurações do navegador.',\n    'audio-capture': 'Nenhum microfone encontrado. Conecte um microfone e tente novamente.',\n    'no-speech': 'Nenhuma fala detectada. Tente novamente.',\n    'network': 'Erro de rede ao tentar reconhecer a fala. Verifique sua conexão.',\n    'sem-suporte': 'Seu navegador não suporta reconhecimento de voz.',\n    'whisper-loading': 'Carregando áudio...',\n    'whisper-processing': 'Processando áudio...',\n};\nfunction isFirefox() {\n    return typeof navigator !== 'undefined' && navigator.userAgent.toLowerCase().includes('firefox');\n}\nasync function audioBufferToFloat32(audioBuffer) {\n    const numberOfChannels = audioBuffer.numberOfChannels;\n    const length = audioBuffer.length;\n    const sampleRate = audioBuffer.sampleRate;\n    let monoData;\n    if (numberOfChannels === 1) {\n        monoData = audioBuffer.getChannelData(0);\n    }\n    else {\n        monoData = new Float32Array(length);\n        for (let i = 0; i < length; i++) {\n            let sum = 0;\n            for (let channel = 0; channel < numberOfChannels; channel++) {\n                sum += audioBuffer.getChannelData(channel)[i];\n            }\n            monoData[i] = sum / numberOfChannels;\n        }\n    }\n    if (sampleRate !== 16000) {\n        const targetLength = Math.round(length * 16000 / sampleRate);\n        const resampled = new Float32Array(targetLength);\n        const ratio = sampleRate / 16000;\n        for (let i = 0; i < targetLength; i++) {\n            const srcIndex = Math.floor(i * ratio);\n            resampled[i] = monoData[Math.min(srcIndex, length - 1)];\n        }\n        return resampled;\n    }\n    return monoData;\n}\nclass WhisperSpeechController {\n    worker = null;\n    mediaRecorder = null;\n    audioChunks = [];\n    stream = null;\n    _listening = false;\n    _supported = true;\n    _error = null;\n    _statusMessage = null;\n    onResult;\n    onChange;\n    constructor(onResult, onChange) {\n        this.onResult = onResult;\n        this.onChange = onChange;\n        this.initWorker();\n    }\n    initWorker() {\n        try {\n            const workerCode = `\n        let transcriber = null;\n        let pipeline = null;\n\n        async function loadPipeline() {\n          if (!pipeline) {\n            const transformers = await import('https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.4.1');\n            pipeline = transformers.pipeline;\n          }\n          return pipeline;\n        }\n\n        self.addEventListener('message', async (event) => {\n          const { audio } = event.data;\n\n          try {\n            if (!transcriber) {\n              self.postMessage({ status: 'loading', message: 'Carregando áudio...' });\n              \n              const pipelineFn = await loadPipeline();\n              transcriber = await pipelineFn('automatic-speech-recognition', 'Xenova/whisper-base');\n            }\n\n            self.postMessage({ status: 'processing', message: 'Transcrevendo áudio localmente...' });\n\n            const output = await transcriber(audio, {\n              chunk_length_s: 30,\n              stride_length_s: 5,\n              language: 'pt',\n              task: 'transcribe',\n              forced_decoder_ids: null,\n              suppress_tokens: [],\n            });\n\n            self.postMessage({ status: 'ready', text: output.text });\n\n          } catch (error) {\n            self.postMessage({ status: 'error', message: error.message });\n          }\n        });\n      `;\n            const blob = new Blob([workerCode], { type: 'application/javascript' });\n            this.worker = new Worker(URL.createObjectURL(blob), { type: 'module' });\n            this.worker.onmessage = (event) => {\n                const { status, text, message } = event.data;\n                switch (status) {\n                    case 'loading':\n                    case 'processing':\n                        this._statusMessage = message;\n                        this.onChange();\n                        break;\n                    case 'ready':\n                        this._statusMessage = null;\n                        this._listening = false;\n                        if (text?.trim()) {\n                            this.onResult(text.trim());\n                        }\n                        this.onChange();\n                        break;\n                    case 'error':\n                        this._error = message || 'Erro ao processar áudio';\n                        this._statusMessage = null;\n                        this._listening = false;\n                        this.onChange();\n                        break;\n                }\n            };\n            this.worker.onerror = (error) => {\n                this._error = `Erro no worker: ${error.message}`;\n                this._listening = false;\n                this.onChange();\n            };\n        }\n        catch {\n            this._supported = false;\n        }\n    }\n    get listening() {\n        return this._listening;\n    }\n    get supported() {\n        return this._supported;\n    }\n    get error() {\n        return this._error;\n    }\n    get statusMessage() {\n        return this._statusMessage;\n    }\n    async toggle() {\n        if (!this._supported) {\n            this._error = MENSAGENS_ERRO['sem-suporte'];\n            this.onChange();\n            return;\n        }\n        this._error = null;\n        if (this._listening) {\n            this.stopRecording();\n        }\n        else {\n            await this.startRecording();\n        }\n    }\n    async startRecording() {\n        try {\n            this.stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n            this.audioChunks = [];\n            this.mediaRecorder = new MediaRecorder(this.stream);\n            this.mediaRecorder.ondataavailable = (event) => {\n                if (event.data.size > 0) {\n                    this.audioChunks.push(event.data);\n                }\n            };\n            this.mediaRecorder.onstop = async () => {\n                await this.processAudio();\n            };\n            this.mediaRecorder.onerror = () => {\n                this._error = MENSAGENS_ERRO['audio-capture'];\n                this._listening = false;\n                this.onChange();\n            };\n            this.mediaRecorder.start();\n            this._listening = true;\n            this.onChange();\n        }\n        catch (err) {\n            if (err.name === 'NotAllowedError') {\n                this._error = MENSAGENS_ERRO['not-allowed'];\n            }\n            else if (err.name === 'NotFoundError') {\n                this._error = MENSAGENS_ERRO['audio-capture'];\n            }\n            else {\n                this._error = `Erro ao acessar microfone: ${err.message}`;\n            }\n            this._listening = false;\n            this.onChange();\n        }\n    }\n    stopRecording() {\n        if (this.mediaRecorder && this.mediaRecorder.state !== 'inactive') {\n            this.mediaRecorder.stop();\n        }\n        if (this.stream) {\n            this.stream.getTracks().forEach(track => track.stop());\n            this.stream = null;\n        }\n    }\n    async processAudio() {\n        if (this.audioChunks.length === 0) {\n            this._error = MENSAGENS_ERRO['no-speech'];\n            this._listening = false;\n            this.onChange();\n            return;\n        }\n        try {\n            const audioBlob = new Blob(this.audioChunks, { type: 'audio/webm' });\n            const arrayBuffer = await audioBlob.arrayBuffer();\n            const audioContext = new AudioContext({ sampleRate: 16000 });\n            const audioBuffer = await audioContext.decodeAudioData(arrayBuffer);\n            const audioData = await audioBufferToFloat32(audioBuffer);\n            this.worker?.postMessage({ audio: audioData });\n            audioContext.close();\n        }\n        catch (err) {\n            this._error = `Erro ao processar áudio: ${err.message}`;\n            this._listening = false;\n            this.onChange();\n        }\n    }\n    stop() {\n        this.stopRecording();\n        this._listening = false;\n    }\n    destroy() {\n        this.stop();\n        this.worker?.terminate();\n    }\n}\nclass NativeSpeechController {\n    recognition = null;\n    _listening = false;\n    _supported = false;\n    _error = null;\n    onResult;\n    onChange;\n    constructor(onResult, onChange) {\n        this.onResult = onResult;\n        this.onChange = onChange;\n        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;\n        if (SpeechRecognition) {\n            this._supported = true;\n            this.recognition = new SpeechRecognition();\n            this.recognition.lang = 'pt-BR';\n            this.recognition.continuous = true;\n            this.recognition.interimResults = false;\n            this.recognition.onresult = (event) => {\n                let textoNovo = '';\n                for (let i = event.resultIndex; i < event.results.length; i++) {\n                    if (event.results[i].isFinal) {\n                        textoNovo += event.results[i][0].transcript;\n                    }\n                }\n                if (textoNovo.trim()) {\n                    this.onResult(textoNovo.trim());\n                }\n            };\n            this.recognition.onerror = (event) => {\n                this._error = MENSAGENS_ERRO[event.error] || `Erro no reconhecimento de voz: ${event.error}`;\n                this._listening = false;\n                this.onChange();\n            };\n            this.recognition.onend = () => {\n                this._listening = false;\n                this.onChange();\n            };\n        }\n    }\n    get listening() {\n        return this._listening;\n    }\n    get supported() {\n        return this._supported;\n    }\n    get error() {\n        return this._error;\n    }\n    toggle() {\n        if (!this._supported) {\n            this._error = MENSAGENS_ERRO['sem-suporte'];\n            this.onChange();\n            return;\n        }\n        this._error = null;\n        if (this._listening) {\n            this.recognition.stop();\n            this._listening = false;\n        }\n        else {\n            try {\n                this.recognition.start();\n                this._listening = true;\n            }\n            catch {\n                this._error = MENSAGENS_ERRO['sem-suporte'];\n            }\n        }\n        this.onChange();\n    }\n    stop() {\n        if (this._listening && this.recognition) {\n            this.recognition.stop();\n            this._listening = false;\n        }\n    }\n    destroy() {\n        this.stop();\n    }\n}\nclass SpeechToTextController {\n    controller;\n    useWhisper;\n    constructor(onResult, onChange) {\n        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;\n        this.useWhisper = isFirefox() || !SpeechRecognition;\n        if (this.useWhisper) {\n            this.controller = new WhisperSpeechController(onResult, onChange);\n        }\n        else {\n            this.controller = new NativeSpeechController(onResult, onChange);\n        }\n    }\n    get listening() {\n        return this.controller.listening;\n    }\n    get supported() {\n        return this.controller.supported;\n    }\n    get error() {\n        return this.controller.error;\n    }\n    get statusMessage() {\n        if (this.useWhisper) {\n            return this.controller.statusMessage;\n        }\n        return null;\n    }\n    toggle() {\n        this.controller.toggle();\n    }\n    stop() {\n        this.controller.stop();\n    }\n    destroy() {\n        this.controller.destroy();\n    }\n}\n\nexport { SpeechToTextController as S };\n"
          },
