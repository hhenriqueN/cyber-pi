            "text": "\n/* - ++resource++collective.polls/css/collective.polls.css - */\n@media screen {\n/* https://www.gov.br/portal_css/++resource++collective.polls/css/collective.polls.css?original=1 */\n#pollresultholder {\nmargin-top: 25px;\n}\n#portletresultholder {\nmargin-top: 25px;\n}\n.votePortlet {\nposition:relative;\n}\n.poll-spinner {\ndisplay:none;\nposition:absolute;\ntop:40%;\ntext-align:center;\nleft:50%;\n}\n.bar-row .bar {\nmax-width: 100%;\n}\n.bar-row .bar span {\ndisplay:none;\n}\n.poll-toggle {\ndisplay: none;\n}\n.poll-toggle.active {\ndisplay: block;\n}\n\n}\n\n"
