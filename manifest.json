{
  "manifest_version": 2,
  "name": "Privacy Guard",
  "version": "0.4.0",
  "description": "Detecta rastreadores, cookies, armazenamento HTML5, fingerprinting e indicadores de hijacking em páginas web.",

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "permissions": [
    "webRequest",
    "cookies",
    "tabs",
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "lib/tldts.umd.min.js",
      "background/background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-hooks.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/storage.js", "content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],

  "browser_action": {
    "default_title": "Privacy Guard",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-guard@insper.edu.br",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}