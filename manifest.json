{
  "manifest_version": 2,
  "name": "Privacy Guard",
  "version": "0.1.0",
  "description": "Detecta rastreadores, cookies, armazenamento HTML5, fingerprinting e indicadores de hijacking em páginas web.",

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "permissions": [
    "webRequest",
    "tabs",
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "lib/tldts.umd.min.js",
      "background/background.js"
    ]
  },

  "browser_action": {
    "default_title": "Privacy Guard",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-guard@insper.edu.br",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
